# Local .terraform directories
**/.terraform/*

# .tfstate files (contain sensitive data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan
*.plan

# CLI config
.terraformrc
terraform.rc

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
